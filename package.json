{
  "name": "istanbul-3d",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "3D visualizations of Istanbul neighborhoods for property browsing",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/fix-cesium-path.mjs",
    "preview": "vite preview --host",
    "data:besiktas": "node scripts/fetch-osm-buildings.mjs --district besiktas",
    "data:query": "node scripts/query-buildings.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "cesium": "^1.121.0"
  },
  "devDependencies": {
    "vite": "^5.4.10",
    "vite-plugin-cesium": "^1.2.23"
  },
  "license": "UNLICENSED"
}
